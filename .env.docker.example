# ==============================================================================
# Docker Port Mappings (Host Side — Avoids Local Collisions)
# ==============================================================================
FORWARD_HTTP_PORT=8000
FORWARD_DB_PORT=3308
FORWARD_PMA_PORT=8082
FORWARD_REDIS_PORT=6380

# ==============================================================================
# Application & Paths
# ==============================================================================
APP_ENV="development"
APP_HOST_NAME="LOCAL"
APP_TIMEZONE="UTC"
APP_URL="http://localhost:8000/"
APP_PATH="/var/www/html/"
APP_DOMAIN="http://localhost:8000"
APP_ASSET_URL=""
APP_STATIC_VERSION="20260902"

APP_DEBUG="1"
APP_DEBUG_BAR="0"
APP_DEBUG_STRICT_MODE="1"

# Frontend (Vite)
VITE_APP_URL="http://localhost:8000/"
VITE_DEBUG="1"
VITE_ASSET_URL=""

# ==============================================================================
# Database (MariaDB 11.4 in Docker)
# ==============================================================================
DB_HOST="db"
DB_DATABASE="bestofxyz"
DB_USERNAME="bestofxyz_user"
DB_PASSWORD="secret"

# ==============================================================================
# Cache & Redis
# ==============================================================================
CACHE_DRIVER="redis"
REDIS_ENABLED="1"
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD=null

# ==============================================================================
# Session
# ==============================================================================
SESSION_DRIVER="redis"
SESSION_LIFETIME=7200

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET="e9b2518e24fa2cb8017cba55d28b1712a201b17dcf49b3896dfa428236166ba8"
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

APP_KEY="base64:f8a1e2d3c4b5a6978877665544332211"
APP_FIRST_KEY=""
APP_SECOND_KEY=""
APP_MASTER_PASSWORD=""

# ==============================================================================
# Mail / SMTP
# ==============================================================================
MAIL_DRIVER="log"
MAIL_HOST="localhost"
MAIL_PORT=1025
MAIL_USERNAME=""
MAIL_PASSWORD=""
MAIL_ENCRYPTION="null"
MAIL_FROM_ADDRESS="no-reply@bestofxyz.local"
MAIL_REPLY_TO="no-reply@bestofxyz.local"
MAIL_ADMIN_EMAIL="admin@bestofxyz.local"
