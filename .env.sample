# ==============================================================================
# Application & Debugging
# ==============================================================================
MIX_APP_ENV="development" # development | staging | production
MIX_HOST_NAME="LOCAL"      # LOCAL | STAGING | LIVE
MIX_TIME_ZONE="UTC"

MIX_URL="http://localhost/"
MIX_PATH="/var/www/bestofxyz/public_html/"
MIX_DOMAIN_NAME="https://bestofxyz.com"
MIX_ASSET_URL=""
MIX_STATIC_VERSION="202408101734"

MIX_DEBUGGING="1"
MIX_DEBUGGING_BAR="0"
MIX_DEBUGGING_STRICT_MODE="1"

# ==============================================================================
# Database (MySQL)
# ==============================================================================
MIX_DB_HOST="localhost"
MIX_DB_NAME="bestofxyz"
MIX_DB_USER="your_db_user"
MIX_DB_PASS="your_db_password"

# ==============================================================================
# Cache & Redis
# ==============================================================================
MIX_CACHE_DRIVER="redis" # redis | file | null
MIX_REDIS_ENABLED="1"
MIX_REDIS_HOST="127.0.0.1"
MIX_REDIS_PASSWORD=null

# ==============================================================================
# Session
# ==============================================================================
MIX_SESSION_DRIVER="redis" # redis | native
MIX_SESSION_LIFETIME=7200

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET="YOUR_64_CHAR_HEX_SECRET" # Generate with: php artisan jwt:secret
JWT_ACCESS_TTL=900                   # 15 minutes
JWT_REFRESH_TTL=604800               # 7 days

MIX_KEY="YOUR_ENCRYPTION_KEY"
MIX_FKEY="YOUR_FIRST_KEY_BASE64"
MIX_SKEY="YOUR_SECOND_KEY_BASE64"
MIX_MSTRPASS="YOUR_MASTER_PASSWORD_HASH"

# ==============================================================================
# Mail / SMTP
# ==============================================================================
MIX_MAIL_DRIVER="log" # smtp | log
MIX_SMTP_HOST="smtp.sendgrid.net"
MIX_SMTP_USER="YOUR_SMTP_USER"
MIX_SMTP_PASS="YOUR_SMTP_PASSWORD"
MIX_SMTP_SENDER="no-reply@bestofxyz.com"
MIX_SMTP_REPLY_TO="no-reply@bestofxyz.com"
MIX_SMTP_ADMIN_EMAIL="admin@bestofxyz.com"
