# ==============================================================================
# Application & Debugging
# ==============================================================================
APP_ENV="development"        # development | staging | production
APP_HOST_NAME="LOCAL"        # LOCAL | STAGING | LIVE
APP_TIMEZONE="UTC"

APP_URL="http://localhost/"
APP_PATH="/var/www/bestofxyz/public_html/"
APP_DOMAIN="https://bestofxyz.com"
APP_ASSET_URL=""
APP_STATIC_VERSION="202408101734"

APP_DEBUG="1"
APP_DEBUG_BAR="0"
APP_DEBUG_STRICT_MODE="1"

# Frontend (Vite)
VITE_APP_URL="http://localhost/"
VITE_DEBUG="1"
VITE_ASSET_URL=""

# ==============================================================================
# Database (MySQL)
# ==============================================================================
DB_HOST="localhost"
DB_DATABASE="bestofxyz"
DB_USERNAME="your_db_user"
DB_PASSWORD="your_db_password"

# ==============================================================================
# Cache & Redis
# ==============================================================================
CACHE_DRIVER="redis"         # redis | file | null
REDIS_ENABLED="1"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD=null

# ==============================================================================
# Session
# ==============================================================================
SESSION_DRIVER="redis"       # redis | native
SESSION_LIFETIME=7200

# ==============================================================================
# Authentication & Security
# ==============================================================================
JWT_SECRET="YOUR_64_CHAR_HEX_SECRET" # Generate with: php artisan jwt:secret
JWT_ACCESS_TTL=900                   # 15 minutes
JWT_REFRESH_TTL=604800               # 7 days

APP_KEY="YOUR_ENCRYPTION_KEY"
APP_FIRST_KEY="YOUR_FIRST_KEY_BASE64"
APP_SECOND_KEY="YOUR_SECOND_KEY_BASE64"
APP_MASTER_PASSWORD="YOUR_MASTER_PASSWORD_HASH"

# ==============================================================================
# Mail / SMTP
# ==============================================================================
MAIL_DRIVER="log"            # smtp | log
MAIL_HOST="smtp.sendgrid.net"
MAIL_PORT=587
MAIL_USERNAME="YOUR_SMTP_USER"
MAIL_PASSWORD="YOUR_SMTP_PASSWORD"
MAIL_ENCRYPTION="tls"
MAIL_FROM_ADDRESS="no-reply@bestofxyz.com"
MAIL_REPLY_TO="no-reply@bestofxyz.com"
MAIL_ADMIN_EMAIL="admin@bestofxyz.com"
