MIX_APP_ENV="development" # development | staging | production

#DEBUGGING
MIX_DEBUGGING="1"
MIX_DEBUGGING_BAR="0"
MIX_DEBUGGING_STRICT_MODE="1"

#CDNs
#Bunny CDN
MIX_BUNNY_CDN_URL="https://example-cdn.net"
MIX_BUNNY_API_KEY="YOUR_BUNNY_API_KEY"
MIX_BUNNY_STORAGE_ZONE="your_storage_zone"
MIX_BUNNY_ZONE_FOLDER="s"    # s = staging, p = production

#Wasabi CDN
MIX_S3_BUCKET_NAME="your_bucket"
MIX_S3_ENDPOINT="https://s3.region.wasabisys.com"
MIX_S3_REGION="your_region"
MIX_S3_STORAGE_KEY="YOUR_S3_KEY"
MIX_S3_STORAGE_SECRET="YOUR_S3_SECRET"

#@DEPRECATED -- move all common images to main bucket viz production or staging on Wasabi
MIX_S3_BUCKET_NAME_COMMON="common_bucket"
MIX_S3_STORAGE_KEY_COMMON="YOUR_COMMON_KEY"
MIX_S3_STORAGE_SECRET_COMMON="YOUR_COMMON_SECRET"

MIX_ASSET_URL=""
MIX_URL="http://localhost/"
MIX_PATH="/var/www/bestofxyz/public_html/"
MIX_RURL_PATH="/var/www/"
MIX_RURL_FOLDER="public_html/"

MIX_LANDING_PAGE_URL="http://localhost/"
MIX_LP_SUBDOMAIN="mylp" # mylp (local) | lp (staging) | my (production)
MIX_HOST_NAME="LOCAL" #BETA | LIVE | STAGING

MIX_DB_HOST="localhost"
MIX_DB_USER="your_db_user"
MIX_DB_PASS="your_db_password"
MIX_DB_NAME="your_db_name"

MIX_MAIL_DRIVER="log" #smtp | log

MIX_STATIC_VERSION="202408101734"
MIX_DOMAIN_NAME="https://example.com"

# JS build needs these (process.env.MIX_*)
MIX_PERXI_MEDIA="/images/editor"
MIX_PERXI_WEB_FONTS_API="YOUR_FONTS_API_KEY"
MIX_TRANSPARENT_IMAGE="https://cdn.example.com/transparent-bg.png"
MIX_IMAGE_RESIZE_URL="https://resize.example.com/q:i/r:0/wp:0/w:850/u:"

# Encryption Keys
MIX_KEY="YOUR_ENCRYPTION_KEY"
MIX_FKEY="YOUR_FIRST_KEY"
MIX_SKEY="YOUR_SECOND_KEY"
MIX_WEBHOOK_SECRET="YOUR_WEBHOOK_SECRET"

MIX_MSTRPASS="YOUR_HASHED_PASSWORD"

# SMTP Credentials
MIX_SMTP_ADMIN_EMAIL="admin@example.com"
MIX_SMTP_HOST="smtp.example.com"
MIX_SMTP_USER="YOUR_SMTP_USER"
MIX_SMTP_PASS="YOUR_SMTP_PASSWORD"
MIX_SMTP_REPLY_TO="no-reply@example.com"
MIX_SMTP_SENDER="no-reply@example.com"


#REDIS
MIX_REDIS_ENABLED="1"
MIX_CACHE_DRIVER=redis
MIX_REDIS_HOST=127.0.0.1
MIX_REDIS_PASSWORD=null

# Confluence API credentials
CONFLUENCE_USER=YOUR_CONFLUENCE_USER_EMAIL
CONFLUENCE_API_TOKEN=YOUR_CONFLUENCE_API_TOKEN
CONFLUENCE_SPACE=YOUR_CONFLUENCE_SPACE
CONFLUENCE_BASE_URL=YOUR_CONFLUENCE_BASE_URL

# Slack
SLACK_WEBHOOK_URL=YOUR_SLACK_WEBHOOK_URL

# JWT Authentication
JWT_SECRET=YOUR_JWT_SECRET_KEY_BASE64

