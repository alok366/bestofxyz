{
    "require": {
        "vlucas/phpdotenv": "v5.5.0",
        "psr/log": "1.1.3",
        "guzzlehttp/guzzle": "^7.9",
        "illuminate/database": "^11.0",
        "illuminate/support": "^11.0",
        "laravel/serializable-closure": "^1.3",
        "illuminate/routing": "^11.0",
        "illuminate/http": "^11.0",
        "illuminate/events": "^11.0",
        "illuminate/container": "^11.0",
        "illuminate/validation": "^11.0",
        "illuminate/translation": "^11.0"
    },
    "require-dev": {
        "tracy/tracy": "^2.10"
    },
    "config": {
        "platform-check": false,
        "allow-plugins": {
            "php-http/discovery": true,
            "phpdocumentor/shim": true,
            "cweagans/composer-patches": true
        }
    },
    "extra": {
        "patches": {
        "getresponse/sdk-php-client": {
            "Fix PHP 8.2 nullable param deprecation": "patches/fix-nullable-logger-param.patch"
        }
        }
    },    
    "autoload": {
        "files": ["framework/helpers.php"],
        "psr-4": {
            "": ["system/Services/"],

            "Framework\\": "framework/",

            "App\\": "system/App/",
            "Database\\Seeders\\": "database/seeders/",

            "Utils\\": "system/App/Utilities/"
        }
    }          
}
